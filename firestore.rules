rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    // Validation Blueprints
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && (!('email' in data) || (data.email is string && data.email.size() <= 160))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRiskProfile(data, userId) {
      return data.keys().hasAll([
          'userId', 'currency', 'startingCapital', 'currentBankroll', 'baseBet',
          'strategy', 'maxSteps', 'dailyStopLossPct', 'dailyTakeProfitPct',
          'colorOdds', 'purpleOdds', 'numberOdds', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'currency', 'startingCapital', 'currentBankroll', 'baseBet',
          'strategy', 'maxSteps', 'dailyStopLossPct', 'dailyTakeProfitPct',
          'colorOdds', 'purpleOdds', 'numberOdds', 'createdAt', 'updatedAt'
        ])
        && data.userId is string
        && data.userId == userId
        && isValidId(data.userId)
        && data.currency is string
        && data.currency.size() <= 10
        && data.currency in ['INR', 'BDT', 'USD', 'COIN']
        && data.startingCapital is number
        && data.startingCapital > 0
        && data.startingCapital <= 100000000
        && data.currentBankroll is number
        && data.currentBankroll >= 0
        && data.currentBankroll <= 1000000000
        && data.baseBet is number
        && data.baseBet > 0
        && data.baseBet <= 10000000
        && data.strategy is string
        && data.strategy.size() <= 32
        && data.strategy in ['flat', 'martingale2x', 'recovery25x', 'recovery3x', 'fibonacci', 'dalembert']
        && data.maxSteps is int
        && data.maxSteps >= 1
        && data.maxSteps <= 20
        && data.dailyStopLossPct is number
        && data.dailyStopLossPct >= 1
        && data.dailyStopLossPct <= 100
        && data.dailyTakeProfitPct is number
        && data.dailyTakeProfitPct >= 1
        && data.dailyTakeProfitPct <= 1000
        && data.colorOdds is number
        && data.colorOdds >= 1
        && data.colorOdds <= 10
        && data.purpleOdds is number
        && data.purpleOdds >= 1
        && data.purpleOdds <= 20
        && data.numberOdds is number
        && data.numberOdds >= 1
        && data.numberOdds <= 50
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidDrawArchive(data, userId) {
      return data.keys().hasAll([
          'userId', 'dateKey', 'label', 'sequence', 'drawCount',
          'startPeriod', 'source', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'dateKey', 'label', 'sequence', 'drawCount',
          'startPeriod', 'startTime', 'times', 'source', 'createdAt', 'updatedAt'
        ])
        && data.userId is string
        && data.userId == userId
        && isValidId(data.userId)
        && data.dateKey is string
        && data.dateKey.size() == 10
        && data.dateKey.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && data.label is string
        && data.label.size() >= 1
        && data.label.size() <= 80
        && data.sequence is string
        && data.sequence.size() >= 1
        && data.sequence.size() <= 1500
        && data.sequence.matches('^[0-9]+$')
        && data.drawCount is int
        && data.drawCount >= 1
        && data.drawCount <= 1500
        && data.drawCount == data.sequence.size()
        && data.startPeriod is string
        && data.startPeriod.size() <= 40
        && data.startPeriod.matches('^[a-zA-Z0-9_\\-]*$')
        && (!('startTime' in data) || (data.startTime is string && data.startTime.size() == 5 && data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!('times' in data) || (data.times is string && data.times.size() <= 6000 && data.times.matches('^[0-9]*$') && (data.times.size() == 0 || data.times.size() == data.sequence.size() * 4)))
        && data.source is string
        && data.source.size() <= 16
        && data.source in ['manual', 'bulk', 'csv']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTradeLog(data, userId) {
      return data.keys().hasAll([
          'userId', 'dateKey', 'periodId', 'betType', 'selection',
          'resultDigit', 'stake', 'stepNumber', 'odds', 'outcome',
          'netPnl', 'bankrollAfter', 'note', 'createdAt'
        ])
        && data.keys().hasOnly([
          'userId', 'dateKey', 'periodId', 'betType', 'selection',
          'resultDigit', 'stake', 'stepNumber', 'odds', 'outcome',
          'netPnl', 'bankrollAfter', 'note', 'createdAt'
        ])
        && data.userId is string
        && data.userId == userId
        && isValidId(data.userId)
        && data.dateKey is string
        && data.dateKey.size() == 10
        && data.dateKey.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')
        && data.periodId is string
        && data.periodId.size() >= 1
        && data.periodId.size() <= 40
        && data.betType is string
        && data.betType.size() <= 16
        && data.betType in ['green', 'red', 'purple', 'big', 'small', 'number']
        && data.selection is string
        && data.selection.size() >= 1
        && data.selection.size() <= 16
        && data.resultDigit is int
        && data.resultDigit >= 0
        && data.resultDigit <= 9
        && data.stake is number
        && data.stake > 0
        && data.stake <= 100000000
        && data.stepNumber is int
        && data.stepNumber >= 1
        && data.stepNumber <= 20
        && data.odds is number
        && data.odds >= 1
        && data.odds <= 50
        && data.outcome is string
        && data.outcome.size() <= 10
        && data.outcome in ['win', 'loss']
        && data.netPnl is number
        && data.netPnl >= -100000000
        && data.netPnl <= 1000000000
        && data.bankrollAfter is number
        && data.bankrollAfter >= 0
        && data.bankrollAfter <= 1000000000
        && data.note is string
        && data.note.size() <= 200
        && data.createdAt is timestamp;
    }

    function isValidSavedPattern(data, userId) {
      return data.keys().hasAll(['userId', 'sequence', 'label', 'createdAt'])
        && data.keys().hasOnly(['userId', 'sequence', 'label', 'createdAt'])
        && data.userId is string
        && data.userId == userId
        && isValidId(data.userId)
        && data.sequence is string
        && data.sequence.size() >= 1
        && data.sequence.size() <= 8
        && data.sequence.matches('^[0-9]+$')
        && data.label is string
        && data.label.size() >= 1
        && data.label.size() <= 80
        && data.createdAt is timestamp;
    }

    // User Root Profile (PII isolated to owner only)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId) && (resource == null || existing().uid == request.auth.uid);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);
      allow delete: if false;

      // Money & Risk Profile Settings
      match /settings/{settingId} {
        allow get: if isValidId(userId)
          && isValidId(settingId)
          && settingId == 'riskProfile'
          && isOwner(userId)
          && (resource == null || existing().userId == request.auth.uid);
        allow list: if false;
        allow create: if isValidId(userId)
          && isValidId(settingId)
          && settingId == 'riskProfile'
          && isOwner(userId)
          && isValidRiskProfile(incoming(), userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(settingId)
          && settingId == 'riskProfile'
          && isOwner(userId)
          && isValidRiskProfile(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'currency', 'startingCapital', 'currentBankroll', 'baseBet',
              'strategy', 'maxSteps', 'dailyStopLossPct', 'dailyTakeProfitPct',
              'colorOdds', 'purpleOdds', 'numberOdds', 'updatedAt'
            ])
            || incoming().diff(existing()).affectedKeys().hasOnly(['currentBankroll', 'updatedAt'])
          );
        allow delete: if false;
      }

      // Daily / Batch Draw Sequence Archives (15-30+ days of 1-minute WinGo results)
      match /archives/{archiveId} {
        allow get: if isValidId(userId)
          && isValidId(archiveId)
          && isOwner(userId)
          && (resource == null || existing().userId == request.auth.uid);
        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(archiveId)
          && isOwner(userId)
          && isValidDrawArchive(incoming(), userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId)
          && isValidId(archiveId)
          && isOwner(userId)
          && isValidDrawArchive(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            // Action: Append live 1-minute draw result
            incoming().diff(existing()).affectedKeys().hasOnly(['sequence', 'drawCount', 'times', 'updatedAt'])
            ||
            // Action: Edit batch metadata, times, or correct sequence
            incoming().diff(existing()).affectedKeys().hasOnly(['label', 'sequence', 'drawCount', 'startPeriod', 'startTime', 'times', 'updatedAt'])
          );
        allow delete: if isValidId(userId)
          && isValidId(archiveId)
          && isOwner(userId)
          && existing().userId == request.auth.uid;
      }

      // Trade & Risk Management Ledger
      match /trades/{tradeId} {
        allow get: if isValidId(userId)
          && isValidId(tradeId)
          && isOwner(userId)
          && (resource == null || existing().userId == request.auth.uid);
        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(tradeId)
          && isOwner(userId)
          && isValidTradeLog(incoming(), userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId)
          && isValidId(tradeId)
          && isOwner(userId)
          && existing().userId == request.auth.uid;
      }

      // Saved Pattern Watches
      match /patterns/{patternId} {
        allow get: if isValidId(userId)
          && isValidId(patternId)
          && isOwner(userId)
          && (resource == null || existing().userId == request.auth.uid);
        allow list: if isValidId(userId)
          && isOwner(userId)
          && resource.data.userId == request.auth.uid;
        allow create: if isValidId(userId)
          && isValidId(patternId)
          && isOwner(userId)
          && isValidSavedPattern(incoming(), userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isValidId(userId)
          && isValidId(patternId)
          && isOwner(userId)
          && existing().userId == request.auth.uid;
      }
    }
  }
}
